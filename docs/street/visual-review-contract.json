{
  "schemaVersion": 1,
  "title": "Many Lives South Quay Visual Review",
  "scoreScale": {
    "1": "Broken or misleading",
    "2": "Materially weak",
    "3": "Acceptable but visibly unfinished",
    "4": "Polished and release-ready",
    "5": "Exceptional and portfolio-defining"
  },
  "minimumWeightedScore": 4,
  "dimensions": [
    {
      "id": "functional_clarity",
      "label": "Functional clarity",
      "weight": 25,
      "minimumScore": 4,
      "prompt": "Can a first-time viewer understand the current aim, agent decision, movement, interaction, and consequence without contradictory scene or rail evidence?"
    },
    {
      "id": "composition_hierarchy",
      "label": "Composition and hierarchy",
      "weight": 20,
      "minimumScore": 4,
      "prompt": "Does the scene establish one useful focal order with intentional spacing, scale, balance, breathing room, and map primacy?"
    },
    {
      "id": "system_consistency",
      "label": "Visual-system consistency",
      "weight": 15,
      "minimumScore": 4,
      "prompt": "Do map art, interiors, actors, HUD, rail, typography, icons, cues, materials, and transitions feel authored by one system?"
    },
    {
      "id": "landmark_identity",
      "label": "Scene and landmark identity",
      "weight": 15,
      "minimumScore": 4,
      "prompt": "Are places and interiors recognizable before labels through silhouette, material, entrance, prop, and activity signatures?"
    },
    {
      "id": "legibility_accessibility",
      "label": "Legibility and accessibility",
      "weight": 10,
      "minimumScore": 4,
      "prompt": "Are text, controls, actors, routes, contrast, and state changes readable without clipping, overlap, crowding, or excessive cue density?"
    },
    {
      "id": "state_authenticity",
      "label": "State authenticity",
      "weight": 10,
      "minimumScore": 4,
      "prompt": "Does every event-like prop, marker, label, NPC, route, and consequence correspond to current simulation state rather than decorative or stale implication?"
    },
    {
      "id": "motion_feedback",
      "label": "Motion and feedback",
      "weight": 5,
      "minimumScore": 3,
      "prompt": "Do movement, transitions, pacing, and consequence feedback make the city feel alive, continuous, and responsive rather than static or scripted?"
    }
  ],
  "requiredViewportProfiles": [
    "desktop",
    "mobile",
    "phone-boundary",
    "compact-boundary",
    "tablet-portrait",
    "codex-compact",
    "codex-retina-compact",
    "codex-retina-reported",
    "codex-screenshot-tall",
    "codex-retina-tall"
  ],
  "automaticRejects": [
    "required-shot-coverage",
    "visual-regression",
    "viewport-coverage",
    "fresh-autoplay",
    "saved-run-continuity",
    "route-continuity",
    "interior-identity",
    "page-health"
  ],
  "groupOrder": [
    "opening",
    "responsive",
    "exteriors",
    "edges",
    "routes",
    "interiors",
    "state"
  ],
